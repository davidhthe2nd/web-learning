<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles/main.css" rel="stylesheet" type="text/css">
    <title>Book Notes Diary</title>
</head>

<body>
    <%- include('partials/header') %>
    <a href="/books/new" class="btn btn--primary">+ Add a book</a>

    <div class="sort-links">
      Sort by:
      <a href="/?sort=rating">Rating</a> |
      <a href="/?sort=recent">Recently read</a> |
      <a href="/?sort=title">Title</a> |
      <a href="/">Default</a>
    </div>

    <ul class="book-grid">
        <% books.forEach((book) => { %>
            <%- include('partials/book-card', { book }) %>
        <% }); %>
    </ul>

    <a href="/books/new" class="btn btn--primary">+ Add a book</a>
    <%- include('partials/footer') %>
</body>

</html>