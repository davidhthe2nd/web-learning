<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Blog</title>
</head>
<body>
  <%- include('partials/header') %>
  <h1>My Blog</h1>
  <a href="/new">New Post</a>

  <% if (posts.length === 0) { %>
  <p class="empty">No posts yet. <a href="/new">Write one!</a></p>
    <% } else { %>
  <% posts.forEach(post => { %>
    <article class="post-card">
      <h2><%= post.title %></h2>
      <p class="meta"><%= post.author %> · <%= post.createdAt.toDateString() %></p>
      <p><%= post.content.substring(0, 200) %>…</p>
      <a href="/posts/<%= post.id %>/edit">Edit</a>
      <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </article>
  <% }); %>
    <% } %>
    <%- include('partials/footer') %>
</body>
</html>