<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles/main.css" rel="stylesheet" type="text/css">
    <title>Book Notes Diary</title>
</head>
<body>
  <%- include('header') %>  
  <div class="form-page">
  <h1>Edit "<%= book.title %>"</h1>

  <form action="/books/<%= book.id %>" method="POST">
    <!-- Title/author/cover came from Open Library and aren't editable here -->
    <p>By <%= book.author %> (<%= book.first_publish_year %>)</p>
    <% if (book.cover_url) { %>
      <img src="<%= book.cover_url %>" alt="<%= book.title %> cover">
    <% } %>

    <label for="rating">Rating (1-5):</label>
    <input type="number" id="rating" name="rating" min="1" max="5" value="<%= book.rating %>" required>

    <label for="date_read">Date read:</label>
    <input type="date" id="date_read" name="date_read"
           value="<%= book.date_read ? book.date_read.toISOString().split('T')[0] : '' %>">

    <label for="notes">Notes:</label>
    <textarea id="notes" name="notes" rows="4"><%= book.notes %></textarea>

    <button type="submit" class="btn btn--primary">Save changes</button>
  </form>

  <a href="/">← Back to all books</a>
  </div>
  <%- include('footer') %>
</body>
</html>